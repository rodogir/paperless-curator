{
  "name": "paperless-curator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local worker that suggests and applies Paperless-ngx document metadata using an OpenAI-compatible LLM.",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --target bun --outdir dist --minify"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}

{
  "version": 1,
  "paperless": {
    "baseUrl": "https://paperless.example.com"
  },
  "llm": {
    "baseUrl": "https://api.example.com/v1",
    "model": "your-model-name"
  },
  "stateTags": {
    "pending": "ai-pending",
    "processing": "ai-processing",
    "processed": "ai-processed",
    "review": "ai-review",
    "failed": "ai-failed"
  },
  "dryRun": true,
  "overwrite": {
    "title": false,
    "correspondent": false,
    "documentType": false
  },
  "limits": {
    "maxTitleLength": 128,
    "maxOcrChars": 30000
  },
  "request": {
    "timeoutMs": 30000,
    "maxRetries": 2,
    "retryBackoffMs": 1000
  }
}
